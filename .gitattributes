# ─── Auto-detect text files ───
* text=auto

# ─── Force LF for all text files ───
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.py text eol=lf

# ─── Binary files (do not modify) ───
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.wasm binary

# ─── Linguist overrides (GitHub stats) ───
*.js linguist-language=JavaScript
*.html linguist-language=HTML
*.css linguist-language=CSS
*.json linguist-language=JSON
*.py linguist-language=Python
*.vert linguist-language=GLSL
*.frag linguist-language=GLSL

# ─── Exclude generated files from diff ───
package-lock.json -diff
*.min.js -diff
*.min.css -diff
