# ─── KRONOS-28-ITZA v0.4.1 ───
# Copia a .env y llena tus valores. NUNCA subas .env a git.

# ─── App ───
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
PWA_URL=https://kronos-28-itza.github.io

# ─── Frequency Engine ───
FREQUENCY_BASE=432
CYMATIC_MODE=chladni
GOLD_SHADER=true

# ─── Telemetry (opcional) ───
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influx_token_here
INFLUX_ORG=kronos
INFLUX_BUCKET=cymatic

# ─── Crypto Seal ───
GPG_KEY_ID=your_gpg_key_id
SEALO_PATH=./SEALO_CALIDAD.json
SBOM_PATH=./SBOM.json

# ─── NOM-151 Chain ───
NOM151_ENABLED=false
NOM151_CHAIN_PATH=./nom151_chain.json
