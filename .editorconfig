# Binarios no tocar - preserva hash 41a3683b intacto
EOF

cat.editorconfig
# ESLint + Prettier + Commitlint + Secret scan + CodeQL
cat >.eslintrc.json <<'EOF'
{
  "root": true,
  "env": {"browser": true, "es2022": true, "node": true},
  "extends": ["eslint:recommended"],
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", {"argsIgnorePattern": "^_"}],
    "no-eval": "error",
    "no-implied-eval": "error"
  }
}
EOF

cat >.prettierrc <<'EOF'
{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf"
}
EOF

cat >.prettierignore <<'EOF'
node_modules
dist
build
certificate/*.pdf
assets/*.mp4
.git
EOF

cat >.gitattributes <<'EOF'
# Preserva integridad SHA-256 41a3683b - no modifiques binarios
*.mp4 binary
*.mov binary
*.pdf binary
*.png binary
*.jpg binary
*.mp3 binary
*.wav binary

# LF obligatorio - NOM-151 conservación mensaje datos
* text=auto eol=lf

# LFS para video génesis
assets/VID-20260708-WA0038.mp4 filter=lfs diff=lfs merge=lfs -text
EOF

cat >.github/workflows/security-audit.yml <<'EOF'
name: Security Audit Máximo - 2607086319439
on: [push, pull_request]
permissions:
  contents: read
  security-events: write
jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Secret Scan - TruffleHog
        uses: trufflesecurity/trufflehog@main
        with:
          path:./
          base: main
          head: HEAD
      - name: Dependency Audit
        run: |
          npm audit --audit-level=high || true
      - name: Validate Certificate Integrity
        run: |
          python3 - <<'PY'
          import json, hashlib
          from pathlib import Path
          idfile = Path('certificate/idfile.json')
          data = json.loads(idfile.read_text())
          assert data['sha256'] == "41a3683bbf83296eeb45da9b0e0ea5a7c095e78b493772e79520a92dbc39f4c3", "SHA mismatch!"
          assert data['size'] == 4726956
          print(f"✅ Safe Creative 2607086319439 SHA-256 OK: {data['sha256']}")
          print(f"✅ Ethereum TX: 0x8ca8e84e1258abac9acb29d14d25114e4775d782ecfda51ae29933247ed2970e")
          PY
      - name: EditorConfig Check
        uses: editorconfig-checker/action-editorconfig-checker@main
      - name: Check No Binaries Modified
        run: |
          if [ -f "assets/VID-20260708-WA0038.mp4" ]; then
            ACTUAL=$(sha256sum assets/VID-20260708-WA0038.mp4 | awk '{print $1}')
            EXPECTED="41a3683bbf83296eeb45da9b0e0ea5a7c095e78b493772e79520a92dbc39f4c3"
            if [ "$ACTUAL"!= "$EXPECTED" ]; then echo "❌ Video modificado!"; exit 1; fi
            echo "✅ Video génesis intacto"
          else
            echo "⚠️ Video no presente - se omite"
          fi
EOF

cat >.github/workflows/codeql.yml <<'EOF'
name: CodeQL - ISO 27001
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: '0 6 * * 1'
permissions:
  actions: read
  contents: read
  security-events: write
jobs:
  analyze:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: github/codeql-action/init@v3
        with:
          languages: javascript
      - uses: github/codeql-action/analyze@v3
EOF

